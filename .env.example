EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
# Optional: pin a Hugging Face model revision/commit for reproducible embeddings.
# EMBEDDING_MODEL_REVISION=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

INDEX_CHUNKS_PATH=data/processed/embedding_ready/chunks.jsonl
INDEX_OUTPUT_DIR=data/processed/indexes
INDEX_COLLISION_DOCUMENTS=true

QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=sih26045_chunks
QDRANT_DISTANCE=Cosine
QDRANT_UPSERT_BATCH_SIZE=128
QDRANT_TIMEOUT_SECONDS=60

BM25_K1=1.5
BM25_B=0.75
BM25_LOWERCASE=true
BM25_REMOVE_STOPWORDS=false

# Qdrant Cloud:
# QDRANT_MODE=cloud
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=replace-with-secret-outside-git
